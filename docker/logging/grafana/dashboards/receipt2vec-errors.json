{
  "uid": "receipt2vec-errors",
  "title": "Receipt2Vec 에러",
  "description": "ERROR / CRITICAL 로그만 모아 보기 (스택트레이스 포함) + 경고",
  "tags": [
    "receipt2vec",
    "logs",
    "errors"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "title": "← 전체 로그",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/receipt2vec-logs?${__url_time_range}"
    },
    {
      "title": "컨테이너 상태",
      "type": "link",
      "icon": "apps",
      "url": "/d/receipt2vec-containers?${__url_time_range}"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "label": "service",
          "stream": "{project=\"rag-base\"}",
          "type": 1
        },
        "definition": "label_values({project=\"rag-base\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "search",
        "label": "검색어",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "에러 (선택 기간)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({project=\"rag-base\", service=~\"$service\", level=~\"ERROR|CRITICAL\"} [$__range]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "최근 1시간 에러",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({project=\"rag-base\", service=~\"$service\", level=~\"ERROR|CRITICAL\"} [1h]))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "서비스별 에러",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({project=\"rag-base\", service=~\"$service\", level=~\"ERROR|CRITICAL\"} [$__auto]))",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "에러 없음",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "min": 0
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "에러 추이",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 6
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({project=\"rag-base\", service=~\"$service\", level=~\"ERROR|CRITICAL\"} [$__auto]))",
          "legendFormat": "{{service}} 에러"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (count_over_time({project=\"rag-base\", service=~\"$service\", level=\"WARNING\"} [$__auto]))",
          "legendFormat": "{{service}} 경고"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*에러"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*경고"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "자주 나는 에러 (메시지별)",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "format": "table",
          "expr": "topk(15, sum by (service, message) (count_over_time({project=\"rag-base\", service=~\"$service\", level=~\"ERROR|CRITICAL\"} | regexp `\\| rid=[^|]*\\| [^|]*\\| (?P<message>[^=]{1,60}?)(?: [A-Za-z_]+=|$)` [$__range])))"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "service": "서비스",
              "message": "에러 메시지",
              "Value": "횟수",
              "Value #A": "횟수"
            },
            "indexByName": {
              "message": 0,
              "service": 1,
              "Value #A": 2,
              "Value": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "횟수",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "에러 없음"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "횟수"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "에러 로그 (스택트레이스 포함)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 18
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{project=\"rag-base\", service=~\"$service\", level=~\"ERROR|CRITICAL\"} |~ \"(?i)$search\""
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "경고 로그",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 8,
          "type": "logs",
          "title": "경고 로그",
          "gridPos": {
            "x": 0,
            "y": 37,
            "w": 24,
            "h": 14
          },
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "{project=\"rag-base\", service=~\"$service\", level=\"WARNING\"} |~ \"(?i)$search\""
            }
          ],
          "options": {
            "showTime": true,
            "showLabels": true,
            "wrapLogMessage": true,
            "enableLogDetails": true,
            "dedupStrategy": "none",
            "sortOrder": "Descending"
          }
        }
      ]
    }
  ]
}