{
  "uid": "receipt2vec-containers",
  "title": "Receipt2Vec 컨테이너",
  "description": "컨테이너 실행·헬스 상태, 재시작, CPU·메모리·네트워크·디스크",
  "tags": [
    "receipt2vec",
    "containers"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "로그",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/receipt2vec-logs?${__url_time_range}"
    },
    {
      "title": "에러",
      "type": "link",
      "icon": "bolt",
      "url": "/d/receipt2vec-errors?${__url_time_range}"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(docker_container_up, service)",
          "refId": "q"
        },
        "definition": "label_values(docker_container_up, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "실행 중",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(docker_container_up{service=~\"$service\"})",
          "legendFormat": "실행"
        },
        {
          "refId": "B",
          "instant": true,
          "expr": "count(docker_container_up{service=~\"$service\"})",
          "legendFormat": "전체"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "문제 있는 컨테이너",
      "description": "중지됐거나 healthcheck 가 unhealthy 인 컨테이너 수",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "count((docker_container_up{service=~\"$service\"} == 0) or (docker_container_health{service=~\"$service\", status=\"unhealthy\"} == 1)) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "재시작 (선택 기간)",
      "description": "컨테이너가 다시 시작된 횟수 (수동 재배포 포함)",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(changes(docker_container_started_at_seconds{service=~\"$service\"}[$__range])) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "전체 메모리",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(docker_container_memory_usage_bytes{service=~\"$service\"}) / scalar(docker_host_memory_bytes) * 100"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "메모리 사용량",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(docker_container_memory_usage_bytes{service=~\"$service\"})",
          "legendFormat": "사용"
        },
        {
          "refId": "B",
          "instant": true,
          "expr": "docker_host_memory_bytes",
          "legendFormat": "호스트"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        }
      }
    },
    {
      "id": 6,
      "type": "gauge",
      "title": "전체 CPU",
      "description": "Docker 에 할당된 CPU 전체 대비 사용률",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sum(rate(docker_container_cpu_usage_seconds_total{service=~\"$service\"}[1m])) / scalar(docker_host_cpus) * 100"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "컨테이너 상태",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "UP",
          "instant": true,
          "format": "table",
          "expr": "max by (service, name) (docker_container_up{service=~\"$service\"})"
        },
        {
          "refId": "HEALTH",
          "instant": true,
          "format": "table",
          "expr": "max by (service, name) (docker_container_health{service=~\"$service\", status=\"healthy\"} * 1 + on(service, name) docker_container_health{status=\"unhealthy\"} * 2 + on(service, name) docker_container_health{status=\"starting\"} * 3)"
        },
        {
          "refId": "UPTIME",
          "instant": true,
          "format": "table",
          "expr": "max by (service, name) ((time() - docker_container_started_at_seconds{service=~\"$service\"}) * docker_container_up)"
        },
        {
          "refId": "CPU",
          "instant": true,
          "format": "table",
          "expr": "max by (service, name) (rate(docker_container_cpu_usage_seconds_total{service=~\"$service\"}[1m]) * 100)"
        },
        {
          "refId": "MEM",
          "instant": true,
          "format": "table",
          "expr": "max by (service, name) (docker_container_memory_usage_bytes{service=~\"$service\"})"
        },
        {
          "refId": "MEMPCT",
          "instant": true,
          "format": "table",
          "expr": "max by (service, name) (docker_container_memory_usage_bytes{service=~\"$service\"}) / scalar(docker_host_memory_bytes) * 100"
        },
        {
          "refId": "RESTART",
          "instant": true,
          "format": "table",
          "expr": "max by (service, name) (changes(docker_container_started_at_seconds{service=~\"$service\"}[$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "service": 0,
              "name": 1,
              "Value #UP": 2,
              "Value #HEALTH": 3,
              "Value #UPTIME": 4,
              "Value #CPU": 5,
              "Value #MEM": 6,
              "Value #MEMPCT": 7,
              "Value #RESTART": 8
            },
            "renameByName": {
              "service": "서비스",
              "name": "컨테이너",
              "Value #UP": "상태",
              "Value #HEALTH": "헬스체크",
              "Value #UPTIME": "가동 시간",
              "Value #CPU": "CPU (1코어 기준)",
              "Value #MEM": "메모리",
              "Value #MEMPCT": "메모리 비율",
              "Value #RESTART": "재시작"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "메모리",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "상태"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "● 실행 중",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "● 중지",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "헬스체크"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "-",
                        "color": "text",
                        "index": 0
                      },
                      "1": {
                        "text": "healthy",
                        "color": "green",
                        "index": 1
                      },
                      "2": {
                        "text": "unhealthy",
                        "color": "red",
                        "index": 2
                      },
                      "3": {
                        "text": "starting",
                        "color": "yellow",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "가동 시간"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dtdurations"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU (1코어 기준)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "메모리"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "메모리 비율"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "max",
                "value": 50
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 25
                    },
                    {
                      "color": "red",
                      "value": 40
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "재시작"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "text",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 5
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU 사용률 (1코어 = 100%)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(docker_container_cpu_usage_seconds_total{service=~\"$service\"}[1m]) * 100)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 2
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "메모리 사용량",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (docker_container_memory_usage_bytes{service=~\"$service\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "네트워크 (초당)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(docker_container_network_receive_bytes_total{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} 수신"
        },
        {
          "refId": "B",
          "expr": "-sum by (service) (rate(docker_container_network_transmit_bytes_total{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} 송신"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "디스크 읽기·쓰기 (초당)",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(docker_container_blkio_read_bytes_total{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} 읽기"
        },
        {
          "refId": "B",
          "expr": "-sum by (service) (rate(docker_container_blkio_write_bytes_total{service=~\"$service\"}[1m]))",
          "legendFormat": "{{service}} 쓰기"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "실행 상태 기록",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (service) (docker_container_up{service=~\"$service\"})",
          "legendFormat": "{{service}}"
        }
      ],
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "실행",
                  "color": "green"
                },
                "0": {
                  "text": "중지",
                  "color": "red"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      }
    }
  ]
}