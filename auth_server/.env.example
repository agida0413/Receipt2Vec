# auth_server/.env 로 복사해서 값을 채우세요 (git 제외)
# 각 콘솔에 등록할 Redirect URI:
#   http://localhost:3000/login/oauth2/code/google | naver | kakao
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오 REST API 키
KAKAO_CLIENT_ID=
# 카카오 콘솔 [보안] Client Secret 을 '사용' 으로 켠 경우만
KAKAO_CLIENT_SECRET=

# 선택 (기본값)
# PUBLIC_BASE_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000
# ACCESS_TOKEN_TTL_SEC=1800
# REFRESH_TOKEN_TTL_SEC=1209600
# COOKIE_SECURE=false        # https 운영 시 true
