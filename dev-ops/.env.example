# Jenkins 서버 일반 설정 (.env 로 복사, 비밀값은 여기 말고 secrets/ 에)
JENKINS_URL=http://13.125.111.48:8080/
JENKINS_PORT=8080
JENKINS_ADMIN_ID=admin
# 호스트 docker 그룹 GID (bootstrap-jenkins-host.sh 가 자동 기록: getent group docker | cut -d: -f3)
DOCKER_GID=999

# 소스 저장소 (비공개면 secrets/github_token 채우고 GIT_CREDENTIALS_ID=github)
GIT_REPO_URL=https://github.com/agida0413/Receipt2Vec.git
GIT_BRANCH=master
GIT_CREDENTIALS_ID=
GITHUB_USERNAME=agida0413
# 브랜치 변경 감지 주기 (비우면 자동 빌드 끔, 수동 실행만)
POLL_SCM=H/5 * * * *

# 이미지 저장소 (Docker Hub). 서비스별 태그: backend-latest, ocr-backend-latest …
DOCKERHUB_USERNAME=kimyong120413
IMAGE_REPO=kimyong120413/reciept2vec

# 배포 대상 RAG 서버
RAG_HOST=15.164.106.172
RAG_SSH_USER=ec2-user
# 사용자가 접속하는 주소 (OAuth 콜백 기준). 실제 배포 값은 deploy/prod.env 가 우선
PUBLIC_BASE_URL=https://kyj.ai.kr
