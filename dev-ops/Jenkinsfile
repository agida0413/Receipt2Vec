// =============================================================================
// Receipt2Vec CI/CD 파이프라인
//   Checkout → 이미지 빌드 → 단위 테스트 → Docker Hub 푸시 → RAG 서버 배포 → 외부 확인 → Slack 알림
//
// 이미지: ${IMAGE_REPO}:<서비스>-latest (배포용) + <서비스>-<커밋> (롤백용)
//   서비스 = backend, ocr-backend, auth-server, frontend, opensearch
// 시크릿: 전부 Jenkins Credentials (dev-ops/casc/jenkins.yaml) — withCredentials 로만 꺼내 쓰고 로그에는 마스킹
// =============================================================================

def SERVICES = [
    [name: 'backend',     context: 'rag_backend'],
    [name: 'ocr-backend', context: 'ocr_backend'],
    [name: 'auth-server', context: 'auth_server'],
    [name: 'frontend',    context: 'frontend'],
    [name: 'opensearch',  context: 'docker/opensearch', args: '--build-arg OPENSEARCH_VERSION=2.19.2'],
]

pipeline {
    agent any
    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 120, unit: 'MINUTES')
    }
    parameters {
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: '단위 테스트 실행 (rag·ocr·auth)')
        booleanParam(name: 'PUSH_IMAGES', defaultValue: true, description: 'Docker Hub 에 푸시')
        booleanParam(name: 'DEPLOY', defaultValue: true, description: 'RAG 서버에 배포')
        string(name: 'DEPLOY_TAG', defaultValue: 'latest',
               description: '배포할 이미지 태그. latest = 방금 푸시한 최신. 롤백은 커밋 해시(12자리)')
        booleanParam(name: 'DEPLOY_ONLY', defaultValue: false, description: '빌드·테스트·푸시 없이 DEPLOY_TAG 로 배포만 (롤백용)')
    }
    environment {
        DOCKER_BUILDKIT = '1'
        IMAGE_REPO = "${env.IMAGE_REPO ?: 'kimyong120413/reciept2vec'}"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHA = sh(script: 'git rev-parse --short=12 HEAD', returnStdout: true).trim()
                    env.GIT_MSG = sh(script: 'git log -1 --pretty=%s', returnStdout: true).trim()
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.GIT_SHA}"
                    currentBuild.description = env.GIT_MSG
                }
            }
        }

        stage('Build images') {
            when { expression { !params.DEPLOY_ONLY } }
            steps {
                script {
                    for (s in SERVICES) {
                        // 이전 latest 이미지를 캐시로 사용 (새 Jenkins 서버에서도 torch·paddle 레이어 재사용)
                        sh """
                            docker pull -q ${IMAGE_REPO}:${s.name}-latest >/dev/null 2>&1 || true
                            docker build ${s.args ?: ''} \\
                                --cache-from ${IMAGE_REPO}:${s.name}-latest --build-arg BUILDKIT_INLINE_CACHE=1 \\
                                --label org.opencontainers.image.revision=${env.GIT_SHA} \\
                                -t ${IMAGE_REPO}:${s.name}-${env.GIT_SHA} -t ${IMAGE_REPO}:${s.name}-latest ${s.context}
                        """
                    }
                }
            }
        }

        stage('Unit tests') {
            when { expression { params.RUN_TESTS && !params.DEPLOY_ONLY } }
            // 빌드한 이미지 안에서 저장소의 테스트 실행 (Jenkins 작업공간을 --volumes-from 으로 공유)
            parallel {
                stage('rag_backend') {
                    steps { sh "bash dev-ops/scripts/run-tests.sh rag_backend ${IMAGE_REPO}:backend-${env.GIT_SHA}" }
                }
                stage('ocr_backend') {
                    steps { sh "bash dev-ops/scripts/run-tests.sh ocr_backend ${IMAGE_REPO}:ocr-backend-${env.GIT_SHA}" }
                }
                stage('auth_server') {
                    steps { sh "bash dev-ops/scripts/run-tests.sh auth_server ${IMAGE_REPO}:auth-server-${env.GIT_SHA}" }
                }
            }
        }

        stage('Push to Docker Hub') {
            when { expression { params.PUSH_IMAGES && !params.DEPLOY_ONLY } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS')]) {
                    script {
                        // 로그인 정보는 이번 빌드 전용 폴더에만 (Jenkins 홈에 남기지 않음)
                        withEnv(["DOCKER_CONFIG=${env.WORKSPACE}/.docker-ci"]) {
                            sh 'mkdir -p "$DOCKER_CONFIG" && echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin'
                            try {
                                for (s in SERVICES) {
                                    sh "docker push -q ${IMAGE_REPO}:${s.name}-${env.GIT_SHA} && docker push -q ${IMAGE_REPO}:${s.name}-latest"
                                }
                            } finally {
                                sh 'docker logout || true; rm -rf "$DOCKER_CONFIG"'
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy to RAG server') {
            when { expression { params.DEPLOY && (params.PUSH_IMAGES || params.DEPLOY_ONLY) } }
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DH_USER', passwordVariable: 'DH_PASS'),
                    file(credentialsId: 'app-root-env', variable: 'ROOT_ENV'),
                    file(credentialsId: 'app-rag-backend-env', variable: 'RAG_ENV'),
                    file(credentialsId: 'app-ocr-backend-env', variable: 'OCR_ENV'),
                    file(credentialsId: 'app-auth-server-env', variable: 'AUTH_ENV'),
                ]) {
                    sshagent(credentials: ['rag-server-ssh']) {
                        sh "DEPLOY_TAG='${params.DEPLOY_TAG}' bash dev-ops/scripts/deploy.sh"
                    }
                }
            }
        }

        stage('Smoke test (external)') {
            when { expression { params.DEPLOY && (params.PUSH_IMAGES || params.DEPLOY_ONLY) } }
            steps {
                script {
                    // 도메인(HTTPS)으로 확인. DNS·인증서가 아직이면 IP(HTTP)로 확인하고 UNSTABLE 로 표시
                    def rc = sh(returnStatus: true, script: 'bash dev-ops/scripts/smoke-test.sh')
                    if (rc == 2) {
                        unstable('도메인(HTTPS) 접속 전 단계 — 서비스는 IP 로 정상. DNS A 레코드·인증서 발급 확인')
                    } else if (rc != 0) {
                        error('외부 확인 실패 — 서비스 이상')
                    }
                }
            }
        }
    }

    post {
        success { script { notifySlack('good', "배포 성공 :white_check_mark:") } }
        unstable { script { notifySlack('warning', "배포됨, 도메인(HTTPS) 확인 필요 :warning:") } }
        failure { script { notifySlack('danger', "빌드/배포 실패 :x:") } }
        always {
            sh 'rm -rf deploy-bundle .docker-ci || true; docker image prune -f >/dev/null 2>&1 || true'
        }
    }
}

def notifySlack(String color, String title) {
    withCredentials([string(credentialsId: 'slack-webhook', variable: 'SLACK_URL')]) {
        if (!env.SLACK_URL?.trim()) { return }
        def text = "${title}\\n*${env.JOB_NAME}* #${env.BUILD_NUMBER} `${env.GIT_SHA ?: '-'}` ${env.GIT_MSG ?: ''}\\n" +
                   "대상: ${env.PUBLIC_BASE_URL ?: env.RAG_HOST} · 태그: ${params.DEPLOY_TAG} · <${env.BUILD_URL}|빌드 로그>"
        writeFile file: '.slack.json', text: groovy.json.JsonOutput.toJson(
            [attachments: [[color: color, text: text.replace('\\n', '\n'), mrkdwn_in: ['text']]]])
        sh 'curl -fsS -X POST -H "Content-Type: application/json" --data @.slack.json "$SLACK_URL" >/dev/null || true; rm -f .slack.json'
    }
}
