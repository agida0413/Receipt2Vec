# =============================================================================
# 운영 도메인 설정 (비밀 아님 → 저장소에서 관리)
# Jenkins 배포 시 서버의 ~/receipt2vec/.env 맨 뒤에 붙음 → 같은 이름이면 이 값이 우선
# 도메인을 바꾸면 이 파일만 고쳐서 master 에 올리고 배포하면 됨
# =============================================================================
# 대표 주소 (DNS A 레코드: kyj.ai.kr → RAG 서버 IP). 다른 이름·IP 로 오면 이 주소로 리다이렉트
DOMAIN=kyj.ai.kr
# 인증서에 넣을 이름 — DNS 가 실제로 조회되는 이름만 발급에 사용
# (지금은 kyj.ai.kr 만. 나중에 www A 레코드를 추가하면 다음 갱신 확인(12시간 이내) 때 자동 포함)
CERT_DOMAINS="kyj.ai.kr www.kyj.ai.kr"
SERVER_NAME="kyj.ai.kr www.kyj.ai.kr"
# 사용자가 접속하는 주소 = OAuth 콜백 기준 (https://kyj.ai.kr/login/oauth2/code/{google|naver|kakao})
PUBLIC_BASE_URL=https://kyj.ai.kr
# HTTPS 에서만 리프레시 토큰 쿠키 전송
COOKIE_SECURE=true
GATEWAY_PUBLISH_PORT=80

# 모니터링 (Grafana·Loki·Alloy·Prometheus) 함께 실행 → https://kyj.ai.kr/grafana/ (admin / GRAFANA_ADMIN_PASSWORD)
COMPOSE_PROFILES=logging
GRAFANA_ROOT_URL=https://kyj.ai.kr/grafana/
GRAFANA_SUB_PATH=true
GRAFANA_COOKIE_SECURE=true
# /grafana/ 접근 허용 IP (공백 구분, CIDR 가능). 서버가 보는 '공인 IP' 여야 함 (10.x·192.168.x 같은 내부 IP 는 매칭되지 않음)
GRAFANA_ALLOW="106.101.72.24"
