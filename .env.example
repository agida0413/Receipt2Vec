# docker compose 가 자동으로 읽는 루트 설정 — .env 로 복사해서 사용 (.env 는 git 제외)
# Grafana 알림 → Slack Incoming Webhook URL (비우면 알림 전송 실패만 기록)
SLACK_WEBHOOK_URL=
# Grafana 관리자 비밀번호 (기본 admin)
GRAFANA_ADMIN_PASSWORD=
# 인증 서버 저장소 비밀번호 (MySQL·Redis 최초 기동 시 이 값으로 생성됨 — 바꾸면 볼륨을 새로 만들어야 함)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=
