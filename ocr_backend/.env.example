# =============================================================================
# OCR 백엔드 설정 (.env 로 복사해서 사용, 파일이 없으면 아래 기본값 사용)
# =============================================================================
PORT=3002

# --- PaddleOCR ---
# 인식 언어 (korean 은 한글+영문+숫자 인식 모델 사용)
OCR_LANG=korean
OCR_VERSION=PP-OCRv5
# cpu / gpu:0
OCR_DEVICE=cpu
# 검출/인식 모델. 둘 다 비우면 OCR_LANG/OCR_VERSION 기준 자동 선택(검출=server 모델)
#   CPU 기준 영수증 1장: mobile_det 약 7초 / server_det 약 20초 (server 가 구겨진 사진에 더 강함)
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=korean_PP-OCRv5_mobile_rec
# 문서 방향 분류 / 문서 펴기(왜곡 보정) / 텍스트라인 방향 분류
OCR_USE_DOC_ORIENTATION=true
OCR_USE_DOC_UNWARPING=false
OCR_USE_TEXTLINE_ORIENTATION=true
# 검출 입력 크기 (긴 영수증은 값을 키우면 작은 글씨 인식률 향상, 대신 느려짐)
OCR_DET_LIMIT_SIDE_LEN=1280
OCR_DET_LIMIT_TYPE=max
# 이 점수 미만의 인식 결과는 버림 (0~1)
OCR_MIN_SCORE=0.5
# paddlepaddle 3.3.x 의 oneDNN 버그(ConvertPirAttribute2RuntimeAttribute not support)로 기본 비활성화
OCR_ENABLE_MKLDNN=false
OCR_CPU_THREADS=4

# --- 업로드/전처리 ---
MAX_UPLOAD_MB=15
# 업로드 이미지의 긴 변이 이 값보다 크면 축소
IMAGE_MAX_SIDE=2560

# --- 거래 정규화 / 사용자 확인 ---
TIMEZONE=Asia/Seoul
# OCR 평균 신뢰도가 이 값 미만이면 needsReview
REVIEW_MIN_OCR_SCORE=0.85

# --- LLM 폴백 (규칙 파서가 실패한 경우에만 호출) ---
# off = LLM 미사용 / fallback = 규칙 파서 결과에 문제가 있을 때만 (기본) / always = 항상 LLM 결과 사용
# (요청별로는 use_llm=false 로 끄거나 force_llm=true 로 강제 가능)
LLM_MODE=fallback
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SEC=30
# 0 = thinking 끔 (정형 추출에는 불필요, 응답 속도/비용 절감)
LLM_THINKING_BUDGET=0
# 프롬프트에 넣을 OCR 원문 최대 길이
LLM_MAX_INPUT_CHARS=6000
