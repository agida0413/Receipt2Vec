# =============================================================================
# 환경 설정 파일 (.env)
# =============================================================================

# -----------------------------------------------------------------------------
# OpenSearch 설정
# -----------------------------------------------------------------------------
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_TIMEOUT=3000
INDEX_NAME=person-embeddings-index
SEARCH_PIPELINE_NAME=hybrid-search-pipeline
# 영수증·결제내역 거래 저장소 (ocr_backend 가 /api/transactions 로 저장)
# 별칭 이름. 실제 인덱스는 '<별칭>-v2' (매핑 변경 시 버전을 올려 자동 이관)
TRANSACTION_INDEX=receipt-transactions
# 별칭 도입 전 인덱스. 있으면 최초 기동 시 새 인덱스로 이관 (원본은 보존)
TRANSACTION_LEGACY_INDEX=receipt-transactions-v1
# 단어 검색이 0건일 때 쓰는 의미 검색(벡터 후보 → 리랭커 재채점)의 최소 리랭크 점수 (0~1)
TRANSACTION_SEMANTIC_MIN_SCORE=0.02
# 저장 시 임베딩 생성 (false 면 의미 검색 없이 키워드만)
TRANSACTION_EMBED_ON_SAVE=true

# -----------------------------------------------------------------------------
# 임베딩 모델 설정
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
EMBEDDING_QUERY_PREFIX=query:
EMBEDDING_PASSAGE_PREFIX=passage:

# -----------------------------------------------------------------------------
# LLM 설정
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.3

# -----------------------------------------------------------------------------
# Cross-encoder 리랭킹 설정
# -----------------------------------------------------------------------------
# false 면 모델을 로딩하지 않음 (요청의 use_rerank 도 무시, 기동/메모리 절약)
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_MAX_LENGTH=512
RERANK_BATCH_SIZE=16
# 최종 결과 건수 (하이브리드 후보 50건 → 상위 N건만 응답/LLM 전달)
RESULT_TOP_N=10



# -----------------------------------------------------------------------------
# 데이터 파일 경로
# -----------------------------------------------------------------------------
DATA_CSV_PATH=test/person_dummy.csv

# -----------------------------------------------------------------------------
# 서버 설정
# -----------------------------------------------------------------------------
UVICORN_WORKERS=4
LOG_LEVEL=INFO

# 도메인 설정
ACTIVE_DOMAIN=person
# -----------------------------------------------------------------------------
# 가계부 챗봇 (/api/chat/stream) — Gemini 키는 위 GEMINI_API_KEY 공유
# -----------------------------------------------------------------------------
TIMEZONE=Asia/Seoul
# 질문 해석: auto(Gemini 가능하면 사용) / llm / rule(정규식, 할당량 안 씀)
CHAT_PLANNER=auto
# 답변 생성: auto / llm / template(정해진 문장, 할당량 안 씀)
CHAT_ANSWERER=auto
# 비우면 LLM_MODEL 사용
CHAT_MODEL=
CHAT_LLM_TIMEOUT_SEC=30
CHAT_HISTORY_TURNS=6
CHAT_MAX_RESULT_ROWS=20
# 질문 해석 LLM 에 넘길 사용자 가맹점 수
CHAT_VOCABULARY_SIZE=50
